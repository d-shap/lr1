(* Mathematical expressions grammar *)
(* Supports: numbers, operators (+, -, *, /), parentheses, exponentiation, and functions *)

math_expr = expr ;

expr = expr, '+', term | expr, '-', term | term ;

term = term, '*', power | term, '/', power | power ;

power = primary, '^', power | primary ;

primary = number | '(', expr, ')' | function_name, '(', expr, ')' | '-', primary | '+', primary ;

number = digits | digits, '.', digits ;

digits = ? digit ? | digits, ? digit ? ;

function_name = 'sin' | 'cos' | 'tan' | 'arcsin' | 'arccos' | 'arctan' | 'sinh' | 'cosh' | 'tanh' | 'ln' | 'log' | 'log10' | 'sqrt' | 'abs' | 'exp' | 'floor' | 'ceil' | 'round' ;
